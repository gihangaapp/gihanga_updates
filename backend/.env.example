# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# One origin, or a comma-separated list (useful on Vercel, which serves both
# a stable production domain and a fresh preview domain per branch/PR):
#   FRONTEND_ORIGIN=https://your-app.vercel.app,https://your-app-git-main.vercel.app
FRONTEND_ORIGIN=http://localhost:8080

# ─── Email (Resend — preferred, works on Render) ───────────────────────────
# Sign up free at https://resend.com, create an API key at
# https://resend.com/api-keys. Sends over HTTPS (port 443), which Render's
# free tier never blocks — unlike SMTP. Until you verify a domain at
# https://resend.com/domains, Resend only lets you send FROM
# onboarding@resend.dev and only TO the email you signed up with (fine for
# testing). Verify your own domain and set RESEND_FROM_EMAIL to send to
# anyone.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── Email (SMTP — fallback, only used if RESEND_API_KEY is unset) ────────
# For Gmail: enable 2-Step Verification on the sending account, then create an
# "App Password" at https://myaccount.google.com/apppasswords and use it as
# EMAIL_PASS below (NOT the normal Gmail login password).
# NOTE: Render's free tier blocks outbound port 587 ("Connection timeout" in
# logs). Port 465 (implicit TLS) sometimes still works there; if it also
# times out, the platform is blocking SMTP entirely, which is why
# RESEND_API_KEY above is the preferred/recommended option.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Gihanga Updates <no-reply@gihanga.rw>

# ─── Live streaming video ────────────────────────────────────────────────────
# Browser-native WebRTC is used for live video. No media-provider credentials
# are required; Socket.IO only relays signaling messages.

# ─── Redis (viewer presence & reaction counters) ───────────────────────────
# Optional. Without REDIS_URL the app uses an in-memory fallback, which is
# fine for local development but does NOT survive a restart and does NOT
# work correctly if you run more than one backend instance. Set this for
# production — a free tier is available at https://redis.com/try-free/ or
# run `docker run -p 6379:6379 redis` locally.
REDIS_URL=redis://localhost:6379

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local dev: mongodb://localhost:27017/gihanga-updates
# Production (MongoDB Atlas): copy the connection string from Atlas →
# Database → Connect → "Drivers", insert your database user's password, and
# make sure the database name (after the last /) matches what you want, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gihanga-updates?retryWrites=true&w=majority
# Also whitelist Render's outbound IPs in Atlas → Network Access (or allow
# 0.0.0.0/0 if Render's static outbound IP add-on isn't in use).
MONGODB_URI=mongodb://localhost:27017/gihanga-updates

# ─── File uploads (Cloudinary) ─────────────────────────────────────────────
# Optional for local dev — when unset, uploaded photos/videos/reels/avatars/
# stories are written to backend/uploads on local disk instead. Render's
# filesystem is ephemeral (wiped on every deploy/restart), so production
# MUST set Cloudinary credentials. Get them from your Cloudinary dashboard
# at https://console.cloudinary.com — either paste the single CLOUDINARY_URL
# shown there (cloudinary://<api_key>:<api_secret>@<cloud_name>), or fill in
# the three separate values below. Leave both blank for local-disk mode.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate strong random secrets for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

JWT_STAFF_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_STAFF_REFRESH_SECRET=replace_with_a_long_random_secret
JWT_STAFF_ACCESS_EXPIRES_IN=8h
JWT_STAFF_REFRESH_EXPIRES_IN=7d

# ─── MTN MoMo Open API ───────────────────────────────────────────────────────
# Keep these values server-side only. Do not expose them through Vite/React.
MTN_ENV=sandbox
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_TARGET_ENVIRONMENT=sandbox
MTN_CURRENCY=EUR
# Must be a publicly reachable https URL that MTN can call back — your
# deployed Render backend URL, e.g.:
#   https://gihanga-backend.onrender.com/api/v1/wallet/momo/callback
MTN_CALLBACK_URL=https://your-public-https-host.example.com/api/v1/wallet/momo/callback
# Collections product: RequestToPay deposits.
MTN_COLLECTION_SUBSCRIPTION_KEY=replace_with_mtn_collections_subscription_key
MTN_COLLECTION_API_USER=replace_with_mtn_collections_api_user_uuid
MTN_COLLECTION_API_KEY=replace_with_mtn_collections_api_key
# Disbursements product: Transfer withdrawals. Keep separate from collections.
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=replace_with_mtn_disbursements_subscription_key
MTN_DISBURSEMENT_API_USER=replace_with_mtn_disbursements_api_user_uuid
MTN_DISBURSEMENT_API_KEY=replace_with_mtn_disbursements_api_key
# Optional shared secret if MTN provisions callback authentication for your account.
MTN_CALLBACK_TOKEN=replace_if_provided_by_mtn
