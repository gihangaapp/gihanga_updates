# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:8080

# ─── Email (optional for local development) ─────────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── Email (SMTP — fallback, only used if RESEND_API_KEY is unset) ───────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Gihanga Updates <no-reply@gihanga.rw>

# ─── Live streaming video (LiveKit Cloud SFU) ────────────────────────────────
# Live video is fanned out by LiveKit Cloud (free "Build" plan). The Render
# free tier cannot host an SFU (no inbound UDP), so the SFU itself runs on
# LiveKit's managed cloud, reached over ordinary HTTPS/WSS — nothing UDP-related
# ever touches Render. The backend's only involvement is ONE outbound HTTPS
# call per join request to mint a short-lived token (same pattern as calling
# MongoDB Atlas or Cloudinary as an external service).
#
# Setup: create a free project at https://cloud.livekit.io (no credit card),
# then generate an API key + secret from its dashboard settings and copy the
# project URL below. Also add these three values to Render's environment
# variable settings for the deployed backend service.
#
# NOTE: LiveKit Cloud's free plan has a real monthly usage quota (WebRTC
# participant-minutes, egress, concurrent connections — verify current numbers
# at livekit.io/pricing). Exceeding that quota — not licensing cost — is the
# actual ceiling on this "free" setup. Monitor usage in the LiveKit dashboard.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
# Legacy fallback: when LIVEKIT_* is unset (or the frontend flag
# VITE_USE_LIVEKIT=false), the app falls back to the original browser-native
# WebRTC mesh (STUN only), which needs no credentials.

# ─── Redis (viewer presence & reaction counters) ───────────────────────────
# Optional. Without REDIS_URL the app uses an in-memory fallback.
# REDIS_URL=redis://localhost:6379

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local MongoDB server used by MongoDB Compass.
MONGODB_URI=mongodb://127.0.0.1:27017/gihanga-updates

# ─── File uploads (local disk) ────────────────────────────────────────────────
# Leave these blank to store uploads under backend/uploads.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

JWT_STAFF_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_STAFF_REFRESH_SECRET=replace_with_a_long_random_secret
JWT_STAFF_ACCESS_EXPIRES_IN=8h
JWT_STAFF_REFRESH_EXPIRES_IN=7d

# ─── MTN MoMo Open API ───────────────────────────────────────────────────────
# Keep these values server-side only. Do not expose them through Vite/React.
MTN_ENV=sandbox
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_TARGET_ENVIRONMENT=sandbox
MTN_CURRENCY=EUR
# Leave unset for local development unless using a public tunnel.
MTN_CALLBACK_URL=
# Collections product: RequestToPay deposits.
MTN_COLLECTION_SUBSCRIPTION_KEY=replace_with_mtn_collections_subscription_key
MTN_COLLECTION_API_USER=replace_with_mtn_collections_api_user_uuid
MTN_COLLECTION_API_KEY=replace_with_mtn_collections_api_key
# Disbursements product: Transfer withdrawals. Keep separate from collections.
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=replace_with_mtn_disbursements_subscription_key
MTN_DISBURSEMENT_API_USER=replace_with_mtn_disbursements_api_user_uuid
MTN_DISBURSEMENT_API_KEY=replace_with_mtn_disbursements_api_key
# Optional shared secret if MTN provisions callback authentication for your account.
MTN_CALLBACK_TOKEN=replace_if_provided_by_mtn


# ─── Live stream hygiene (A4) ─────────────────────────────────────────────────
# Server-enforced hard cap on a single live stream. The sweeper ends streams
# that pass maxEndsAt (reason: "Maximum duration (5 hours) reached") and
# streams whose host heartbeat is stale. Override for testing (e.g. the A7
# regression run uses 2 minutes = 0.0333).
LIVE_MAX_HOURS=5
# A host whose lastHeartbeatAt is older than this is considered gone.
LIVE_STALE_HEARTBEAT_SECONDS=90
# How often the sweeper scans (seconds).
LIVE_SWEEP_INTERVAL_SECONDS=30

# ─── Content safety & moderation ─────────────────────────────────────────────
# Full setup guide: docs/MODERATION_SETUP.md
# Defaults are SAFE: pipeline on, fail-closed (failed checks never publish).
# CONTENT_MODERATION_ENABLED=false reverts to pre-moderation behaviour —
# LOCAL DEVELOPMENT ONLY, never in production.
CONTENT_MODERATION_ENABLED=true
CONTENT_MODERATION_FAIL_CLOSED=true
# Normalized category-score thresholds (0..1). Block is forced > review.
# review: at/above this a category routes to human review.
# block: at/above this an auto-reject category is rejected outright.
CONTENT_MODERATION_REVIEW_THRESHOLD=0.5
CONTENT_MODERATION_BLOCK_THRESHOLD=0.8
# Per-call provider timeout (ms) and bounded retries with backoff.
CONTENT_MODERATION_TIMEOUT_MS=15000
CONTENT_MODERATION_MAX_RETRIES=2
# Bounded in-process queue (video frame sampling, deferred image batches).
CONTENT_MODERATION_QUEUE_CONCURRENCY=3
CONTENT_MODERATION_QUEUE_MAX_DEPTH=500
# Video frame sampling: interval between frames (s) and hard cap per video.
CONTENT_MODERATION_VIDEO_FRAME_INTERVAL_SECONDS=10
CONTENT_MODERATION_VIDEO_MAX_FRAMES=12
# Best-effort caps (units noted): minutes / megabytes.
CONTENT_MODERATION_MAX_VIDEO_DURATION=10
CONTENT_MODERATION_MAX_UPLOAD_SIZE_MB=200
# Duplicate-scan avoidance: reuse APPROVED media verdicts for byte-identical
# uploads within this TTL (hours). Scope: owner (default) or global.
CONTENT_MODERATION_HASH_TTL_HOURS=168
CONTENT_MODERATION_HASH_SCOPE=owner
# Run single/few image checks inline for instant feedback (vs queue-only).
CONTENT_MODERATION_SYNC_IMAGE_CHECKS=true

# OpenAI Moderation API — https://platform.openai.com (server-side only!)
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_MODERATION_ENABLED=true
# Optional: transcribe video audio with Whisper and moderate the transcript
# (bills per audio minute — off by default).
OPENAI_TRANSCRIPTION_ENABLED=false

# Google Cloud Vision SafeSearch — https://console.cloud.google.com
# Enable the Cloud Vision API, create a dedicated service account (see
# docs/MODERATION_SETUP.md §2 for the IAM guidance) and point
# GOOGLE_APPLICATION_CREDENTIALS at its downloaded JSON key.
# The key file stays OUT of git and OUT of the frontend — never paste its
# contents into any env var, file in this repo, log or chat.
#
# GOOGLE_CLOUD_PROJECT_ID = the project ID (e.g. my-app-123456), NOT the display name.
# GOOGLE_APPLICATION_CREDENTIALS = absolute path of the key file on the server.
#   - Render: upload the key as a SECRET FILE; it is mounted at
#     /etc/secrets/<Filename you typed>. If you name it
#     gihanga-vision-moderation.json the value is:
#       GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/gihanga-vision-moderation.json
#   - Local dev: an absolute path OUTSIDE this repository.
GOOGLE_CLOUD_VISION_ENABLED=true
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Live-stream safety: AI moderation of chat + automatic enforcement after
# this many host-side violations (auto force-end via the audited endStream path).
LIVE_MODERATION_CHAT_ENABLED=true
LIVE_MODERATION_VIOLATION_LIMIT=3

# TEST/DEV ONLY — deterministic stub provider so the full pipeline can be
# exercised without credentials. HARD-REFUSED when NODE_ENV=production.
# CONTENT_MODERATION_PROVIDER_STUB=true
# CONTENT_MODERATION_STUB_MODE=approve|reject-sexual|reject-violence|review|error|critical
