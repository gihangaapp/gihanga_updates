{
  "name": "gihanga-backend",
  "version": "1.0.0",
  "description": "Gihanga Updates \u2014 Express/MongoDB/Socket.IO backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:users": "tsx src/scripts/seed-users.ts",
    "lint": "eslint src test",
    "test:payment": "tsx --test test/payment-regression.test.ts",
    "test:live": "tsx --test test/live-regression.test.ts test/idempotency.test.ts",
    "test": "tsx --test test/payment-regression.test.ts test/live-regression.test.ts test/idempotency.test.ts test/achievements.test.ts test/moderation-policy.test.ts test/moderation-config.test.ts test/moderation-text.test.ts test/moderation-video.test.ts test/moderation-sanitize.test.ts test/moderation-vision.test.ts",
    "migrate:post-media": "tsx src/scripts/migrate-post-media-meta.ts",
    "seed:achievements": "tsx src/scripts/seed-achievements.ts",
    "test:achievements": "tsx --test test/achievements.test.ts",
    "test:moderation": "tsx --test test/moderation-policy.test.ts test/moderation-config.test.ts test/moderation-text.test.ts test/moderation-video.test.ts test/moderation-sanitize.test.ts test/moderation-vision.test.ts",
    "migrate:moderation": "tsx src/scripts/migrate-moderation-backfill.ts"
  },
  "dependencies": {
    "@google-cloud/vision": "^4.3.3",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.19.0",
    "mongoose": "^8.8.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "openai": "^4.104.0",
    "resend": "^6.22.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.30.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.35.0"
  }
}
