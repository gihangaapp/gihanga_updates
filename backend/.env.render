# ─────────────────────────────────────────────────────────────────────────
# DO NOT COMMIT THIS FILE. It is listed in backend/.gitignore.
#
# This is a reference copy of the values to paste into Render's dashboard
# (Service → Environment) for every key in render.yaml marked `sync: false`.
# render.yaml itself intentionally does NOT contain these values — Render
# reads sync:false keys from the dashboard, not from the committed YAML.
# Keeping secrets out of render.yaml means they're never in your GitHub
# history, even if the repo is later made public, forked, or leaked.
#
# How to use: open https://dashboard.render.com → gihanga-backend →
# Environment, and enter each KEY = VALUE pair below manually (or use
# Render's "Add from .env" bulk-paste option, which accepts this file's
# contents directly).
# ─────────────────────────────────────────────────────────────────────────

# ─── Frontend origin (CORS) ────────────────────────────────────────────────
FRONTEND_ORIGIN=https://gihanga-updates.vercel.app

# ─── MongoDB ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://gihangaupdates:%2AGihanga12345%23@gihangaupdates.umbdxoh.mongodb.net/?appName=gihangaupdates

# ─── Cloudinary (file uploads) ─────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://476237669733832:2G7ShDniIoLnxzHmGdCqsIsgXww@vb6vkczs
CLOUDINARY_CLOUD_NAME=vb6vkczs
CLOUDINARY_API_KEY=476237669733832
CLOUDINARY_API_SECRET=2G7ShDniIoLnxzHmGdCqsIsgXww

# ─── LiveKit (live streaming — the URL itself is already a plain `value` in
# render.yaml since it's not secret; only the key/secret are sync:false) ──
LIVEKIT_API_KEY=APILqsDN4o3ESEG
LIVEKIT_API_SECRET=1nAc9UTuJw3sHMVtouaftE0lpKyC2MhpMywcf54rRml

# ─── Redis (viewer presence & reaction counters) ───────────────────────────
REDIS_URL=redis://default:6zBvrTvdZAnIyNWn7HoaMaNG4uGpv1jE@adaptable-history-genial-72438.db.redis.io:11829

# ─── Email — Resend (preferred; mailer.ts uses this first when set) ───────
RESEND_API_KEY=re_UYgN397q_Pwe7HoCGvwBbtYGdfRXQdyNF
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── Email — SMTP fallback (only used if RESEND_API_KEY is unset) ─────────
# NOTE: EMAIL_PORT=587 is blocked on Render's free tier per this project's
# own .env.example notes — 465 (implicit TLS) is the documented fallback.
# Since RESEND_API_KEY above is set, the SMTP block below is unused unless
# you remove/blank RESEND_API_KEY, so leaving 587 here is harmless as-is.
# If you ever rely on SMTP directly, change EMAIL_PORT to 465 first.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=gihangaapp@gmail.com
EMAIL_PASS=otgf hcts rwnw ikct
EMAIL_FROM=Gihanga Updates <no-reply@gihanga.rw>

# ─── MTN MoMo Open API ──────────────────────────────────────────────────────
# Still placeholders in the values you pasted — MoMo payments will not work
# until these are replaced with real credentials from
# https://momodeveloper.mtn.com. MTN_CALLBACK_URL below has been corrected
# to this project's actual Render URL (from the deploy log you shared);
# the rest are left exactly as provided.
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_TARGET_ENVIRONMENT=sandbox
MTN_CURRENCY=EUR
MTN_CALLBACK_URL=https://gihanga-updates.onrender.com/api/v1/wallet/momo/callback
MTN_COLLECTION_SUBSCRIPTION_KEY=replace_with_mtn_collections_subscription_key
MTN_COLLECTION_API_USER=replace_with_mtn_collections_api_user_uuid
MTN_COLLECTION_API_KEY=replace_with_mtn_collections_api_key
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=replace_with_mtn_disbursements_subscription_key
MTN_DISBURSEMENT_API_USER=replace_with_mtn_disbursements_api_user_uuid
MTN_DISBURSEMENT_API_KEY=replace_with_mtn_disbursements_api_key
MTN_CALLBACK_TOKEN=replace_if_provided_by_mtn
