# ─── Backend API base URL ───────────────────────────────────────────────────
# Local development frontend: http://localhost:8080
# Local development backend:  http://localhost:4000
VITE_API_URL=http://localhost:4000/api/v1

# ─── Live streaming video (LiveKit Cloud SFU) ───────────────────────────────
# When VITE_USE_LIVEKIT=true, the live page connects to LiveKit Cloud (SFU)
# instead of the browser-native WebRTC mesh. The join URL + token are fetched
# from the backend (GET /api/v1/live/:id/livekit-token); VITE_LIVEKIT_URL is
# only used as a fallback if the backend response ever lacks the URL.
# Rollout: flip VITE_USE_LIVEKIT to true once the backend LIVEKIT_* variables
# are set (locally and on Render). Setting it back to false instantly restores
# the old mesh path — keep it in place as a permanent safety switch unless the
# project owner says otherwise.
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# ─── Live video quality & connectivity (A1/A6) ───────────────────────────────
# Capture/publish tuning for BOTH transports. Defaults: 30 fps, 1.8 Mbps top
# layer (720p), 180p/360p simulcast layers on the LiveKit path.
# VITE_LIVE_FPS=30
# VITE_LIVE_MAX_BITRATE_KBPS=1800

# TURN server for the legacy mesh (STUN-only fails on strict/mobile NATs).
# Optional; only used when VITE_USE_LIVEKIT=false. Get free credentials at
# https://www.metered.ca/tools/openrelay/ or run coturn yourself.
# VITE_TURN_URL=turn:openrelay.metered.ca:80
# VITE_TURN_USERNAME=openrelayproject
# VITE_TURN_CREDENTIAL=openrelayproject

# ─── Transport switch (READ ME — §8.7) ───────────────────────────────────────
# The A-series live fixes are LiveKit-primary. VITE_USE_LIVEKIT=true activates
# the SFU path (HD simulcast + viewer split-screen grids). It requires the
# backend LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET to be set.
# With the flag unset/false the app uses the legacy mesh: HD capture + sender
# bitrate + optional TURN from this pass still apply, but viewer co-host
# tiles are SFU-only (an SFU fans every publisher out to every subscriber).
VITE_USE_LIVEKIT=false
